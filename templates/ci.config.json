{
  "$schema": "https://raw.githubusercontent.com/TLEWA/dsh-plugin-ci/v1/schema/ci.config.schema.json",
  "version": 1,
  "build": {
    "command": "npm run build",
    "artifacts": [
      "lib"
    ],
    "mode": "git-diff"
  },
  "typecheck": "npx tsc --noEmit",
  "test": "npm test",
  "testGlobs": [
    "test/**/*.test.mjs",
    "test/**/*.test.ts"
  ],
  "manifest": {
    "manifestVersion": 1,
    "requireEnginesNode": true,
    "allowedInject": [
      "@deepseek-ai/*"
    ]
  },
  "docs": {
    "pairs": [
      [
        "README.md",
        "README.en.md"
      ],
      [
        "CHANGELOG.md",
        "CHANGELOG.en.md"
      ]
    ],
    "required": [
      "README.md",
      "README.en.md",
      "CHANGELOG.md",
      "CHANGELOG.en.md",
      "AGENTS.md",
      "LICENSE",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/workflows/ci.yml",
      ".github/workflows/drift.yml"
    ],
    "published": [
      "README.md",
      "README.en.md",
      "CHANGELOG.md",
      "CHANGELOG.en.md",
      "LICENSE"
    ]
  },
  "tarball": {
    "mustInclude": [
      "lib/index.js",
      "cordis.patch.yml"
    ],
    "mustExclude": [
      "src/**",
      "test/**",
      "scripts/**"
    ],
    "maxBytes": 2097152
  },
  "release": {
    "publish": true,
    "provenance": true
  },
  "guards": {
    "requireHumanApprovedLabel": true
  }
}

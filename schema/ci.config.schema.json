{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/TLEWA/dsh-plugin-ci/main/schema/ci.config.schema.json",
  "title": "dsh-plugin-ci configuration",
  "description": "Every key is required. Use null for a section the repository does not need. Unknown keys are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "install", "build", "typecheck", "test", "testGlobs", "manifest", "docs", "tarball", "release", "guards", "gate"],
  "properties": {
    "version": { "const": 1 },
    "install": { "enum": ["ci", "install", "none"], "description": "ci = npm ci (lockfile), install = npm install, none = no dependencies" },
    "build": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "artifacts", "mode"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "mode": { "enum": ["git-diff", "check-flag"] }
          }
        }
      ]
    },
    "typecheck": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "test": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "testGlobs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "manifest": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifestVersion", "requireEnginesNode", "allowedInject"],
          "properties": {
            "manifestVersion": { "type": "integer", "minimum": 1 },
            "requireEnginesNode": { "type": "boolean" },
            "allowedInject": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairs", "required", "published"],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "minItems": 2, "maxItems": 2 }
        },
        "required": { "type": "array", "items": { "type": "string" } },
        "published": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tarball": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mustInclude", "mustExclude", "maxBytes"],
          "properties": {
            "mustInclude": { "type": "array", "items": { "type": "string" } },
            "mustExclude": { "type": "array", "items": { "type": "string" } },
            "maxBytes": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publish", "provenance", "assetAlias"],
      "properties": {
        "publish": { "type": "boolean" },
        "provenance": { "type": "boolean" },
        "assetAlias": { "type": "string" }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireHumanApprovedLabel"],
      "properties": {
        "requireHumanApprovedLabel": { "type": "boolean" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowUnstamped"],
      "properties": {
        "allowUnstamped": { "type": "boolean" }
      }
    }
  }
}

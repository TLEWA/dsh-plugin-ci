        "PROCESS.md",
        "PROCESS.en.md"
      ],
      [
        "CHANGELOG.md",
        "CHANGELOG.en.md"
      ],
      [
        "docs/architecture.md",
        "docs/architecture.en.md"
      ],
      [
        "AGENTS.md",
        "AGENTS.en.md"
      ],
      [
        "docs/gates.md",
        "docs/gates.en.md"
      ],
      [
        "docs/model-playbook.md",
        "docs/model-playbook.en.md"
      ],
      [
        "docs/release.md",
        "docs/release.en.md"
      ]
    ],
    "required": [
      "README.md",
      "README.en.md",
      "PROCESS.md",
      "PROCESS.en.md",
      "CHANGELOG.md",
      "CHANGELOG.en.md",
      "AGENTS.md",
      "AGENTS.en.md",
